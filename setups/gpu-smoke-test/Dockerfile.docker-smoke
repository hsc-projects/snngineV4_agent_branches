# Dockerfile for SNNgineV4 GPU CUDA-OpenGL Zero-Copy Interop Smoke Test
# Phase 1: Automated Headless EGL Check
# Phase 2: Offscreen Visual Confirmation
# Phase 3: Interactive GUI Check
# Base: Ubuntu 24.04 LTS (Noble) with CUDA 12.6 & Python 3.12
FROM nvidia/cuda:12.6.2-devel-ubuntu24.04

# Enable NVIDIA driver capabilities for CUDA compute and OpenGL/EGL graphics
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics,display
ENV DEBIAN_FRONTEND=noninteractive
ENV QT_QPA_PLATFORM=xcb
ENV PATH="/opt/venv/bin:$PATH"

# Install system dependencies (including Qt XCB / X11 runtime libraries on Ubuntu 24.04)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    libgl1-mesa-dev \
    libegl1-mesa-dev \
    libgles2-mesa-dev \
    libglvnd-dev \
    pkg-config \
    ca-certificates \
    libxkbcommon-x11-0 \
    libglib2.0-0t64 \
    libfontconfig1 \
    libdbus-1-3 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xfixes0 \
    libxcb-xinerama0 \
    libxcb-cursor0 \
    libxcb-xkb1 \
    && rm -rf /var/lib/apt/lists/*

# Create dedicated virtual environment to isolate from Debian system packages
RUN python3 -m venv /opt/venv

# Upgrade pip and install core scientific / GPU python packages
# PyTorch with CUDA 12.4 support + PyQt6 / VisPy for Phase 3 GUI
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir \
    torch==2.5.1 --index-url https://download.pytorch.org/whl/cu124 && \
    pip install --no-cache-dir \
    "numpy<2" \
    numba \
    PyOpenGL \
    PyOpenGL_accelerate \
    pytools \
    appdirs \
    mako \
    PyQt6 \
    qtpy \
    vispy

# Build and install PyCUDA with OpenGL interop enabled (--cuda-enable-gl)
# PyCUDA v2024.1 configured for CUDA 12.6 and Python 3.12
RUN git clone --recurse-submodules -b v2024.1 https://github.com/inducer/pycuda.git /tmp/pycuda && \
    cd /tmp/pycuda && \
    python3 ./configure.py \
        --cuda-root=/usr/local/cuda \
        --cuda-enable-gl && \
    pip install --no-cache-dir --no-build-isolation . && \
    cd / && rm -rf /tmp/pycuda

WORKDIR /workspace
