# Dockerfile for SNNgineV4 GPU CUDA-OpenGL Zero-Copy Interop Smoke Test
# Phase 1: Automated Headless EGL Check
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

# Enable NVIDIA driver capabilities for CUDA compute and OpenGL/EGL graphics
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics,display
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    python3 \
    python3-dev \
    python3-pip \
    libgl1-mesa-dev \
    libegl1-mesa-dev \
    libgles2-mesa-dev \
    libglvnd-dev \
    pkg-config \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install core scientific / GPU python packages
# PyTorch with CUDA 12.4 support
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel && \
    pip3 install --no-cache-dir \
    torch==2.5.1 --index-url https://download.pytorch.org/whl/cu124 && \
    pip3 install --no-cache-dir \
    "numpy<2" \
    numba \
    PyOpenGL \
    PyOpenGL_accelerate \
    pytools \
    appdirs \
    mako

# Build and install PyCUDA with OpenGL interop enabled (--cuda-enable-gl)
# PyCUDA 2024.1 or git master
RUN cd /tmp && \
    git clone --recursive https://github.com/inducer/pycuda.git && \
    cd pycuda && \
    git checkout v2024.1 && \
    python3 ./configure.py \
        --cuda-root=/usr/local/cuda \
        --cuda-enable-gl && \
    make -j$(nproc) install && \
    cd / && rm -rf /tmp/pycuda

WORKDIR /workspace
