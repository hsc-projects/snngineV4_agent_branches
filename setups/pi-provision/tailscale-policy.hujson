// Tailscale access policy (admin console > Access controls), drafted 2026-10-11.
// Not a secret; kept here as the record of what the tailnet should allow.
// Based on Tailscale's stock default policy: Tailscale's own example comments are
// kept, and lines starting with "PI:" are this project's comments and changes.
//
// PI: Effect: the Pi is tagged tag:pi (tagged nodes have no key expiry); the
// PI: maintainer's own devices may open SSH (tcp 22) on it and nothing else; the Pi
// PI: itself may not start connections to other devices. Funnel and Tailscale SSH
// PI: are left as in the stock policy.
{
	// Declare static groups of users. Use autogroups for all users or users with a specific role.
	// "groups": {
	//  	"group:example": ["alice@example.com", "bob@example.com"],
	// },

	// Define the tags which can be applied to devices and by which users.
	// PI: tag:pi goes on the Pi (Machines > the Pi > Edit ACL tags), or the Pi joins
	// PI: with `tailscale up --advertise-tags=tag:pi`. Owned by the tailnet admins.
	"tagOwners": {
		"tag:pi": ["autogroup:admin"],
	},

	// Define grants that govern access for users, groups, autogroups, tags,
	// Tailscale IP addresses, and subnet ranges.
	"grants": [
		// Allow all connections.
		// Comment this section out if you want to define specific restrictions.
		// PI: commented out on purpose (this was the stock allow-all grant):
		// {"src": ["*"], "dst": ["*"], "ip": ["*"]},

		// PI: the maintainer's own devices (phone, later the laptop) may open SSH on
		// PI: the Pi and nothing else. Nothing else has any access, including the Pi
		// PI: itself towards other devices. Add a rule here when the sandbox needs to
		// PI: reach the Pi (for example the proxy port).
		{
			"src": ["autogroup:member"],
			"dst": ["tag:pi"],
			"ip":  ["tcp:22"],
		},

		// Allow users in "group:example" to access "tag:example", but only from
		// devices that are running macOS and have enabled Tailscale client auto-updating.
		// {"src": ["group:example"], "dst": ["tag:example"], "ip": ["*"], "srcPosture":["posture:autoUpdateMac"]},
	],

	// Define postures that will be applied to all rules without any specific
	// srcPosture definition.
	// "defaultSrcPosture": [
	//      "posture:anyMac",
	// ],

	// Define device posture rules requiring devices to meet
	// certain criteria to access parts of your system.
	// "postures": {
	//      // Require devices running macOS, a stable Tailscale
	//      // version and auto update enabled for Tailscale.
	// 	"posture:autoUpdateMac": [
	// 	    "node:os == 'macos'",
	// 	    "node:tsReleaseTrack == 'stable'",
	// 	    "node:tsAutoUpdate",
	// 	],
	//      // Require devices running macOS and a stable
	//      // Tailscale version.
	// 	"posture:anyMac": [
	// 	    "node:os == 'macos'",
	// 	    "node:tsReleaseTrack == 'stable'",
	// 	],
	// },

	// Define users and devices that can use Tailscale SSH.
	// PI: unchanged from the stock policy. No device has Tailscale SSH switched on
	// PI: (the Pi uses its normal sshd), so this rule is idle.
	"ssh": [
		// Allow all users to SSH into their own devices in check mode.
		// Comment this section out if you want to define specific restrictions.
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],
	"nodeAttrs": [
		{
			// Funnel policy, which lets tailnet members control Funnel
			// for their own devices.
			// Learn more at https://tailscale.com/kb/1223/tailscale-funnel/
			// PI: unchanged from the stock policy.
			"target": ["autogroup:member"],
			"attr":   ["funnel"],
		},
	],

	// Test access rules every time they're saved.
	// PI: the editor refuses to save if one of these fails. The source is the
	// PI: phone's tailnet address (fairphone-5-5g, 100.108.215.27).
	"tests": [
		{
			"src":    "100.108.215.27",
			"accept": ["tag:pi:22"],
			"deny":   ["tag:pi:80", "tag:pi:2375"],
		},
	],
}
